# Copy to .env (make setup does this) and fill in. NEVER commit .env.
# Distil Labs needs no key here: run `distil auth` (or `distil signup`) once;
# the CLI keeps its own session in ~/.config/distillabs/.

# ---------------------------------------------------------------------------
# Langfuse (tracing + trace export): Langfuse UI -> Project Settings -> API Keys
# With both keys set, every teacher/base/tuned call from the eval and the demo is
# traced (tags: eval / demo). Leave either empty to turn tracing off. docs/invoice.md
# ---------------------------------------------------------------------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Optional filters for `make traces`: generation name (teacher/base/tuned), ISO start date (2026-10-01), max rows
LANGFUSE_GENERATION_NAME=
LANGFUSE_FROM=
LANGFUSE_LIMIT=2000

# ---------------------------------------------------------------------------
# Runpod (serving). The console works without RUNPOD_API_KEY.
# ---------------------------------------------------------------------------
RUNPOD_API_KEY=
# OpenAI-compatible URL of the vLLM server on your pod: https://<pod-id>-8000.proxy.runpod.net/v1
SERVE_BASE_URL=
# The value the pod was started with (serve/start_vllm.sh reads VLLM_API_KEY)
SERVE_API_KEY=
# Your pod's hourly price in USD, used for cost per 1k requests
RUNPOD_GPU_USD_PER_HOUR=
# Only for gated base models (Llama, Gemma). Qwen3.5 does not need it.
HF_TOKEN=

# ---------------------------------------------------------------------------
# Teacher endpoint (optional): latency + cost of the big model.
# Any OpenAI-compatible API, e.g. https://openrouter.ai/api/v1
# ---------------------------------------------------------------------------
TEACHER_BASE_URL=
TEACHER_API_KEY=
TEACHER_MODEL=
TEACHER_USD_PER_M_INPUT=
TEACHER_USD_PER_M_OUTPUT=
